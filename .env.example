# ═══════════════════════════════════════════════════════════════════════════════
#  BARBERÍA · variables de entorno
#
#  Copia este archivo a .env.local y rellena los valores.
#  .env.local está en .gitignore: NUNCA lo subas al repositorio.
#
#  Regla de oro: todo lo que empieza por NEXT_PUBLIC_ acaba en el navegador y
#  cualquiera puede leerlo. Lo demás sólo existe en el servidor.
#
#  Las credenciales van VACÍAS a propósito. Un valor de relleno tipo
#  "0x4AAAAAAA..." es peor que nada: el código lo toma por configuración real,
#  intenta usarlo y falla de formas confusas (Turnstile rechazaría todas las
#  reservas). Vacío significa "no configurado", y eso el código sí lo entiende.
#  El formato de cada valor está en el comentario de arriba de cada variable.
# ═══════════════════════════════════════════════════════════════════════════════


# ── SUPABASE ───────────────────────────────────────────────────────────────────
# Panel → Project Settings → API

# La URL del proyecto. Pública, no es secreta.  (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave "anon" / "publishable". Va al navegador a propósito: está limitada por
# el RLS, y el rol anon no tiene ni un GRANT sobre citas, clientes ni pagos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️  SECRETA. Ignora el RLS por completo: con ella se lee y se escribe TODA la
# base. Sólo servidor y crons.
#   · NUNCA le pongas el prefijo NEXT_PUBLIC_
#   · NUNCA la importes en un componente 'use client'
#   · Si se filtra, rótala desde el panel de Supabase de inmediato
SUPABASE_SERVICE_ROLE_KEY=


# ── CLOUDFLARE R2 · capturas de pago ───────────────────────────────────────────
# dash.cloudflare.com → R2 → Create bucket (déjalo PRIVADO, sin dominio público)
# Luego: R2 → Manage API tokens → Create API token (permiso Object Read & Write)

# El ID de cuenta sale de la URL del panel de Cloudflare, o de la página de R2.
# Sin las cuatro, /api/captura responde 503 con un mensaje claro.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=


# ── RESEND · correos automáticos ───────────────────────────────────────────────
# resend.com → API Keys → Create API Key (permiso: Sending access)
# Vacía = no se envía ningún correo (se registra el intento y se sigue).
RESEND_API_KEY=

# El remitente, formato:  Barbería <reservas@tudominio.com>
# El dominio tiene que estar verificado en Resend (Domains → Add Domain →
# registrar los DNS). Sin verificar, sólo puedes enviarte correos a ti mismo.
RESEND_FROM=


# ── CLOUDFLARE TURNSTILE · anti-bots ───────────────────────────────────────────
# dash.cloudflare.com → Turnstile → Add site. Es gratis y sin límite.
# Ambas empiezan por 0x4AAAAAAA...
#
# VACÍAS = verificación DESACTIVADA. Es lo correcto en desarrollo.
# ⚠️ Rellena las DOS o ninguna. Con sólo el secreto puesto (o con un valor de
# relleno), el servidor pregunta a Cloudflare con un secreto que no existe y
# RECHAZA TODAS LAS RESERVAS con "No pudimos verificar que eres una persona".
#
# En producción rellénalas: sin ellas, /api/reservar queda abierto a bots que
# pueden ocupar toda la agenda con reservas basura de 15 minutos cada una.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ── DATOS DEL LOCAL ────────────────────────────────────────────────────────────
NEXT_PUBLIC_NOMBRE_LOCAL=EL TEMPLO
NEXT_PUBLIC_DIRECCION_LOCAL=Jr. Próceres de la Independencia 2390, San Juan de Lurigancho, Lima

# URL pública del sitio, sin barra final. Se usa en los correos y en el .ics.
NEXT_PUBLIC_URL_SITIO=https://tudominio.com

# Opcional: imagen del QR de Yape (súbela a R2 público, a Cloudinary o al
# directorio /public). Si la dejas vacía, la pantalla de pago muestra el
# número de Yape del barbero en grande, que funciona igual de bien.
NEXT_PUBLIC_YAPE_QR_URL=

# Correo de contacto para ejercer los derechos de la Ley 29733 (acceso,
# rectificación, cancelación y oposición). Sale en /privacidad. Si lo dejas
# vacío, esa página dice que se pidan en el local — legal, pero peor.
NEXT_PUBLIC_EMAIL_CONTACTO=


# ── RESPALDO MENSUAL ───────────────────────────────────────────────────────────
# Contraseña del ZIP cifrado (AES-256) con los datos personales.
# Ley 29733 (Perú): el respaldo lleva nombres, teléfonos y correos, y tiene que
# viajar y guardarse protegido. Usa una contraseña larga y guárdala en tu
# gestor de contraseñas, NO en este archivo en producción.
RESPALDO_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════════════
#  SECRETOS DE GITHUB ACTIONS (Settings → Secrets and variables → Actions)
#
#  Secrets:   NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#             RESEND_API_KEY, RESEND_FROM, RESPALDO_PASSWORD
#  Variables: NEXT_PUBLIC_NOMBRE_LOCAL, NEXT_PUBLIC_DIRECCION_LOCAL,
#             NEXT_PUBLIC_URL_SITIO
# ═══════════════════════════════════════════════════════════════════════════════
